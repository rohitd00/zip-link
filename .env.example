# Copy this file to .env and fill in real local values.
# Never commit a file named .env with real values in it.

NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# PostgreSQL connection strings for the API and worker. DATABASE_TEST_URL is used
# only by the automated test suite (a separate, disposable database).
DATABASE_URL=postgresql://url_shortener_app:CHANGE_ME@127.0.0.1:5432/url_shortener_dev
DATABASE_TEST_URL=postgresql://url_shortener_app:CHANGE_ME@127.0.0.1:5432/url_shortener_test

# Redis connection strings, used for the redirect cache, the creation rate
# limiter (Phase 3), and the click-analytics queue (Phase 4). REDIS_TEST_URL
# points at a different logical Redis database (index 1) on the same server so
# automated tests never touch data used by a locally running dev server.
REDIS_URL=redis://127.0.0.1:6379
REDIS_TEST_URL=redis://127.0.0.1:6379/1

# Secret used to HMAC-hash visitor IP addresses before analytics storage.
# Generate a long random value; never reuse this across environments.
IP_HASH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
IP_HASH_KEY_VERSION=v1

# Secret used to sign the anonymous owner-context cookie.
OWNER_COOKIE_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

REDIRECT_CACHE_TTL_SECONDS=86400
CREATE_RATE_LIMIT_MAX_REQUESTS=20
CREATE_RATE_LIMIT_WINDOW_SECONDS=900
ANALYTICS_WORKER_CONCURRENCY=10
LOG_LEVEL=info
