# Copy this file to .env and fill in real local values.
# Never commit a file named .env with real values in it.

NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# PostgreSQL connection strings for the API and worker. DATABASE_TEST_URL is used
# only by the automated test suite (a separate, disposable database).
DATABASE_URL=postgresql://url_shortener_app:CHANGE_ME@127.0.0.1:5432/url_shortener_dev
DATABASE_TEST_URL=postgresql://url_shortener_app:CHANGE_ME@127.0.0.1:5432/url_shortener_test

# Redis connection strings, used for the redirect cache, the creation rate
# limiter (Phase 3), and the click-analytics queue (Phase 4). REDIS_TEST_URL
# points at a different logical Redis database (index 1) on the same server so
# automated tests never touch data used by a locally running dev server.
REDIS_URL=redis://127.0.0.1:6379
REDIS_TEST_URL=redis://127.0.0.1:6379/1

# Secret used to HMAC-hash visitor IP addresses before analytics storage.
# Generate a long random value; never reuse this across environments.
IP_HASH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
IP_HASH_KEY_VERSION=v1

# Secret used to sign the anonymous owner-context cookie.
OWNER_COOKIE_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

REDIRECT_CACHE_TTL_SECONDS=86400
CREATE_RATE_LIMIT_MAX_REQUESTS=20
CREATE_RATE_LIMIT_WINDOW_SECONDS=900
ANALYTICS_WORKER_CONCURRENCY=10
LOG_LEVEL=info

# Number of reverse proxies/load balancers sitting in front of this API.
# Leave this at 0 (or unset) anywhere requests arrive directly, including
# local development and docker-compose — trusting X-Forwarded-For with
# nothing in front to set it honestly would let any caller spoof their own
# IP address. Set it to the real number of hops (usually 1) only when
# actually deployed behind a platform's own proxy (Render, Railway, etc.),
# so the analytics IP hash and the creation rate limiter see the real
# visitor address instead of the proxy's own.
TRUST_PROXY_HOPS=0

# Base URL of the frontend dashboard (Vercel in production, Vite dev server
# locally). Used to build links the API sends users to: the password-reset
# email link and the redirect destinations after Google sign-in succeeds or
# fails. Leave unset locally to default to http://localhost:5173.
DASHBOARD_BASE_URL=http://localhost:5173

# Google OAuth 2.0 credentials (from the Google Cloud Console). Both must be
# set for "Continue with Google" to be enabled — leave both unset to disable
# it entirely, which is the default for local development. The redirect URI
# configured in the Google Cloud Console must match
# ${PUBLIC_BASE_URL}/api/auth/google/callback exactly.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Resend (https://resend.com) API key used to send welcome and password-reset
# emails. Leave unset locally — emails are logged instead of sent when this
# is not set, so no external account is required for local development.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=ZipLink <onboarding@resend.dev>

# Rate limit applied to signup/login/password-reset-request, separate from
# CREATE_RATE_LIMIT_* above.
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
