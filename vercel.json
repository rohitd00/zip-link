{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE_WITH_YOUR_RENDER_API_URL.onrender.com/api/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://REPLACE_WITH_YOUR_RENDER_API_URL.onrender.com/health/:path*"
    }
  ]
}
