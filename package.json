{
  "name": "url-shortener-analytics",
  "version": "0.1.0",
  "private": true,
  "description": "URL shortener with cache-first redirects and asynchronous click analytics.",
  "scripts": {
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:worker": "tsx watch apps/worker/src/worker.ts",
    "dev:web": "vite --config apps/web/vite.config.mts",
    "build:web": "vite build --config apps/web/vite.config.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:up": "node-pg-migrate up -m database/migrations",
    "migrate:down": "node-pg-migrate down -m database/migrations",
    "migrate:create": "node-pg-migrate create -m database/migrations --",
    "maintain:partitions": "tsx scripts/create-future-click-event-partitions.ts",
    "rollup:run": "tsx scripts/runAnalyticsRollup.ts",
    "seed": "tsx scripts/seedSampleData.ts"
  },
  "dependencies": {
    "bullmq": "^6.3.4",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "geoip-lite": "^2.0.3",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.39.0",
    "pg": "^8.13.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "ua-parser-js": "^2.0.10",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "jsdom": "^29.1.1",
    "node-pg-migrate": "^7.9.1",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
